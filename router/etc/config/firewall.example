# OpenWrt Firewall Configuration Template (/etc/config/firewall)

config defaults
	option syn_flood '1'
	option input 'REJECT'
	option output 'ACCEPT'
	option forward 'REJECT'

config zone
	option name 'lan'
	option input 'ACCEPT'
	option output 'ACCEPT'
	option forward 'ACCEPT'
	list network 'lan'

config zone
	option name 'wan'
	option input 'REJECT'
	option output 'ACCEPT'
	option forward 'REJECT'
	option masq '1'
	option mtu_fix '1'
	list network 'wan'
	list network 'wan6'
	list network 'wwan'
	list device 'wg0'

config forwarding
	option src 'lan'
	option dest 'wan'

# Allow SSH from WireGuard Tunnel interface
config rule
	option name 'Allow-SSH-Tunnel'
	option src 'wan'
	option proto 'tcp'
	option dest_port '22'
	option target 'ACCEPT'

# Allow Web Portal from WireGuard Tunnel interface
config rule
	option name 'Allow-Web-Tunnel'
	option src 'wan'
	option proto 'tcp'
	option dest_port '80 443'
	option target 'ACCEPT'
