# OpenWrt System Startup Hook
# Place in /etc/rc.local

# Policy routing bypass: Ensure LAN clients can always access local router services (192.168.1.1)
ip rule del pref 90 2>/dev/null || true
ip rule add pref 90 iif br-lan to 192.168.1.0/24 lookup main
ip rule del pref 91 2>/dev/null || true
ip rule add pref 91 iif br-lan to 10.8.0.0/24 lookup main

exit 0
